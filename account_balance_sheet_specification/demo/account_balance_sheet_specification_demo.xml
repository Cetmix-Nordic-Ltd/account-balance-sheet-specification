<odoo>
    <record
        id="account_balance_sheet_specification_demo"
        model="account.balance.sheet.specification"
    >
        <field name="name">Balance sheet specification (demo)</field>
        <field name="company_id" ref="base.main_company" />
        <field name="date" eval="DateTime.today().strftime('%Y-12-31')" />
    </record>
    <function model="account.balance.sheet.specification" name="action_compute">
        <value eval="[ref('account_balance_sheet_specification_demo')]" />
    </function>
</odoo>
