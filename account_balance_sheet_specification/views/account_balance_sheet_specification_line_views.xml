<odoo>
    <record id="account_balance_sheet_specification_line_view_form" model="ir.ui.view">
        <field name="model">account.balance.sheet.specification.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_open_move_lines"
                        type="object"
                        string="Journal Items"
                        icon="fa-list"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="account_id" />
                        </h2>
                        <field name="group_name" class="text-muted" />
                    </div>
                    <group>
                        <group>
                            <field name="balance" />
                            <field name="method" />
                        </group>
                        <group>
                            <field name="auto_amount" />
                            <field name="manual_amount" />
                            <field
                                name="difference"
                                decoration-danger="difference != 0"
                                decoration-success="difference == 0"
                            />
                        </group>
                    </group>
                    <field name="state" invisible="1" />
                    <field name="currency_id" invisible="1" />
                    <field
                        name="item_ids"
                        readonly="state != 'draft'"
                        context="{'default_kind': 'manual'}"
                    >
                        <list
                            editable="bottom"
                            decoration-muted="kind == 'auto'"
                            decoration-warning="copied"
                        >
                            <field name="sequence" widget="handle" />
                            <field name="kind" readonly="1" />
                            <field name="name" readonly="kind == 'auto'" />
                            <field
                                name="partner_id"
                                readonly="kind == 'auto'"
                                optional="show"
                            />
                            <field
                                name="reference"
                                readonly="kind == 'auto'"
                                optional="show"
                            />
                            <field
                                name="date"
                                readonly="kind == 'auto'"
                                optional="show"
                            />
                            <field
                                name="amount"
                                readonly="kind == 'auto'"
                                sum="Total"
                            />
                            <field name="copied" optional="show" />
                            <field name="currency_id" column_invisible="1" />
                            <field name="res_model" column_invisible="1" />
                            <field name="res_id" column_invisible="1" />
                            <button
                                name="action_open_source"
                                type="object"
                                icon="fa-external-link"
                                title="Open source"
                                invisible="not res_id"
                            />
                        </list>
                    </field>
                    <group>
                        <field name="note" readonly="state != 'draft'" />
                        <field
                            name="attachment_ids"
                            widget="many2many_binary"
                            readonly="state != 'draft'"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
